# Copy to deploy/docker/.env. Generate unique credentials before starting.
SERVER_APP_ENV=production
SERVER_APP_KEY=
SERVER_APP_DEBUG=false
SERVER_APP_URL=http://localhost:8000
SERVER_APP_BIND_ADDRESS=127.0.0.1
SERVER_APP_PORT=8000
SERVER_LOG_LEVEL=info

SERVER_DB_NAME=boxsys
SERVER_DB_BIND_ADDRESS=127.0.0.1
SERVER_DB_PORT=5432
SERVER_DB_USER=boxsys
SERVER_DB_PASSWORD=

SERVER_CACHE_BIND_ADDRESS=127.0.0.1
SERVER_CACHE_PORT=6379
SERVER_CACHE_PASSWORD=

# Optional image overrides; pin reviewed digests for reproducible deployments.
# POSTGRES_IMAGE=postgres:18-alpine
# REDIS_IMAGE=redis:8-alpine
