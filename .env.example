# @fileoverview
# Global environment variables reference for the BoxSys monorepo.
# This file documents only the variables and options relevant to this project.
#
# IMPORTANT: This file is for DOCUMENTATION PURPOSES ONLY and must NOT be used directly.
#
# Each individual app, package, and component must define its own .env file with the
# required variables specific to its context. This file serves as a quick reference guide
# to understand what environment configurations need to be set up across the monorepo.
#
# Use this file to:
# - Quickly identify all required environment variables
# - Understand what needs to be configured in each .env file
# - Maintain consistency across the monorepo configuration
#
# NOTE: For production deployments with Docker, use environment variables instead of .env files.
# Set all variables directly in your Docker container configuration (docker-compose.yaml or
# container runtime environment) for better security and flexibility.
#
# @see Configure environment variables in the respective .env files for each package/app
# @see Use environment variables in Docker/production environments

# ==== Server Environment Variables (apps/server/.env) ====

APP_NAME=BoxSys
APP_ENV=local                       # local | production | testing
APP_KEY=                            # Generate using `php artisan key:generate` 
APP_DEBUG=true                      # true | false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file         # file | database

LOG_CHANNEL=stack                   # stack | single | daily
LOG_STACK=single                    # single | daily  - if LOG_CHANNEL=stack, specify the channel to stack here, separated by comma if multiple
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # debug | info | notice | warning | error | critical

DB_CONNECTION=pgsql                 # Server only supports PostgreSQL (its use of SQLite is only for testing purposes). Do not change this value.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=boxsys
DB_USERNAME=root
DB_PASSWORD=
DB_URL=                             # Optional: Full database connection URL instead of individual parameters. Format: postgres://username:password@host:port/database. Take precedence over individual DB_* settings if provided.

SESSION_DRIVER=database             # file | database | redis | array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false               # true | false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database                # file | database | redis | array | null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL=                          # Optional: Full Redis connection URL instead of individual parameters. Format: redis://username:password@host:port. Take precedence over individual REDIS_* settings if provided.

# ==== Bruno API Collection - Server (docs/api-collections/Server/.env) ====

SERVER_URL="http://localhost:8000"
SERVER_API_TOKEN=""


# ==== Docker Compose Variables (docker/.env) ====

# Note:
# The docker/.env.example file contains sensible default values required by
# Docker Compose. Its goal is to provide a fully functional development
# environment out of the box, reducing the amount of manual configuration
# needed to get started.

